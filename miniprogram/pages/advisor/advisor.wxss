.brand-card {
  margin-bottom: 24rpx;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 16rpx;
  background: #ffffff;
  color: #17243a;
  font-size: 25rpx;
  font-weight: 700;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #1f58a7;
  font-size: 22rpx;
}

.language-choice-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 12rpx;
}

.language-score-row {
  display: grid;
  grid-template-columns: minmax(150rpx, 0.75fr) minmax(0, 1.6fr);
  gap: 14rpx;
  align-items: center;
  width: 100%;
  margin-top: 12rpx;
}

.language-score-type {
  min-width: 0;
  overflow: hidden;
  color: #1f4f87;
  font-size: 23rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.language-score-input {
  min-width: 0;
  width: 100%;
}

.manual-entry-callout {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #cfe0f5;
  border-radius: 16rpx;
  background: #eef6ff;
}

.manual-entry-title {
  color: #1f4f87;
  font-size: 25rpx;
  font-weight: 900;
}

.manual-entry-desc,
.review-guide {
  color: #526174;
  font-size: 22rpx;
  line-height: 1.55;
}

.manual-entry-callout .secondary-button {
  width: 100%;
  max-width: 100%;
  margin-top: 4rpx;
  white-space: normal;
}

.review-heading {
  flex: 1;
  min-width: 0;
}

.review-heading .label,
.review-guide {
  display: block;
}

.review-guide {
  margin-top: 6rpx;
}

.file-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 18rpx 18rpx 18rpx 22rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.file-copy {
  flex: 1;
  min-width: 0;
}

.file-name,
.file-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-name {
  color: #17243a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.file-meta {
  margin-top: 6rpx;
  color: #526174;
  font-size: 22rpx;
  line-height: 1.3;
}

.file-delete {
  flex-shrink: 0;
  width: 104rpx;
  max-width: 104rpx;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #d93025;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.file-delete::after {
  border: 1rpx solid rgba(217, 48, 37, 0.24);
  border-radius: 999rpx;
}

.transcript-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.mini-button,
.row-delete {
  flex-shrink: 0;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.mini-button::after,
.row-delete::after {
  border: 1rpx solid rgba(31, 88, 167, 0.22);
  border-radius: 999rpx;
}

.transcript-table {
  margin-top: 14rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.transcript-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.transcript-row.header {
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.transcript-edit-card {
  margin-top: 12rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 14rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  background: #ffffff;
}

.transcript-row.second {
  grid-template-columns: minmax(0, 1fr);
  margin-top: 10rpx;
}

.transcript-input {
  min-width: 0;
  width: 100%;
  max-width: 100%;
  min-height: 62rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: #f7f9fc;
  color: #17243a;
  font-size: 23rpx;
  line-height: 1.2;
}

.transcript-field { display: block; min-width: 0; margin-top: 12rpx; }
.transcript-label { display: block; margin-bottom: 8rpx; color: #526174; font-size: 23rpx; line-height: 1.5; }

.row-delete {
  width: auto;
  min-width: 132rpx;
  max-width: 100%;
  padding: 0 20rpx;
  color: #d93025;
}

.row-delete::after {
  border-color: rgba(217, 48, 37, 0.24);
}

.transcript-card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.preview-summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  background: #f7f9fc;
  color: #31445f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.compliance-note {
  margin: 16rpx 0 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #cfe0f5;
  border-radius: 14rpx;
  background: #eef6ff;
  color: #1f4f87;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.manual-match-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 14rpx;
}

.manual-match-actions button {
  width: 100%;
  min-width: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.manual-match-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #cfe0f5;
  border-radius: 16rpx;
  background: #f7fbff;
}

.manual-match-desc {
  display: block;
  margin: 8rpx 0 14rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.5;
}

.preview-title {
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.preview-note {
  color: #785900;
  font-size: 22rpx;
  font-weight: 900;
}

.transcript-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.transcript-actions .primary-button,
.transcript-actions .secondary-button {
  width: 100%;
  min-width: 0;
  padding-left: 18rpx;
  padding-right: 18rpx;
}

.review-status,
.match-readiness {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fff8e6;
  color: #785900;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.review-status.ok,
.match-readiness.ready {
  background: #eaf7ef;
  color: #17633a;
}
