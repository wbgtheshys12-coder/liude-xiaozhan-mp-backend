.material-actions {
  width: 100%;
  max-width: 100%;
}

.material-actions picker {
  flex: 1 1 220rpx;
  min-width: 0;
}

.material-actions button {
  flex: 1 1 220rpx;
  min-width: 0;
}

.upload-button {
  width: 100%;
  margin-top: 18rpx;
}

.upload-record {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #e3ebf5;
}

.training-consent-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f4f8fd;
}

.training-consent-copy {
  flex: 1;
  min-width: 0;
}

.training-consent-title,
.training-consent-desc {
  display: block;
}

.training-consent-title {
  color: #173f78;
  font-size: 25rpx;
  font-weight: 900;
}

.training-consent-desc {
  margin-top: 8rpx;
  color: #526174;
  font-size: 22rpx;
  line-height: 1.5;
}

.upload-record-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.compact-action {
  flex: 1 1 220rpx;
  min-height: 68rpx;
  padding: 10rpx 18rpx;
  font-size: 23rpx;
}

.compact-action.danger {
  color: #a83232;
  border-color: rgba(168, 50, 50, 0.24);
}

.checklist-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.checklist-tabs {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.checklist-tab {
  min-width: 78rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4fb;
  color: #526174;
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
}

.checklist-tab.active {
  background: #1f58a7;
  color: #ffffff;
}

.checklist-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.check-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #12b895;
  flex-shrink: 0;
}

.check-text {
  color: #25354d;
  font-size: 25rpx;
  line-height: 1.5;
}
