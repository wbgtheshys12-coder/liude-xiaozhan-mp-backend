.admin-course-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.hero,
.form-card,
.list-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
}

.title,
.section-title {
  display: block;
  color: #17243a;
  font-size: 34rpx;
  font-weight: 900;
}

.summary,
.course-meta,
.notice,
.upload-note {
  display: block;
  margin-top: 10rpx;
  color: #526174;
  font-size: 25rpx;
  line-height: 1.55;
}

.storage-notice {
  display: block;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.storage-notice.safe { background: #e9f7ef; color: #236345; }
.storage-notice.risk { background: #fff4e5; color: #8a5300; }

.video-status {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dce6f2;
  border-radius: 14rpx;
  background: #ffffff;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  border-radius: 50%;
  background: #8391a5;
}

.video-status.ready .status-dot {
  background: #1f7a55;
}

.video-status.uploading .status-dot {
  background: #1f58a7;
}

.video-status.missing .status-dot {
  background: #b45309;
}

.upload-progress {
  width: 100%;
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dce8f5;
}

.upload-progress-bar {
  height: 100%;
  border-radius: inherit;
  background: #1f58a7;
  transition: width .18s ease;
}

.status-title {
  color: #26374d;
  font-size: 25rpx;
  font-weight: 900;
}

.status-detail {
  display: block;
  margin-top: 8rpx;
  color: #526174;
  font-size: 22rpx;
  overflow-wrap: anywhere;
}

.notice {
  color: #8a5b0a;
  font-weight: 800;
}

.upload-panel {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #dce6f2;
  border-radius: 16rpx;
  background: #f8fbff;
}

.upload-panel .input {
  margin-top: 0;
  background: #ffffff;
}

.upload-note {
  color: #66748a;
  font-size: 23rpx;
  font-weight: 700;
}

.input,
.textarea,
.input-like {
  width: 100%;
  min-height: 82rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dce6f2;
  background: #f8fbff;
  box-sizing: border-box;
  color: #17243a;
  font-size: 26rpx;
}

.textarea {
  min-height: 150rpx;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.button-row.compact {
  margin-top: 14rpx;
}

.primary-button,
.secondary-button {
  min-height: 78rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.primary-button {
  background: #1f58a7;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  color: #1f58a7;
  border: 1rpx solid #d6e4f4;
}

.secondary-button.danger {
  color: #a6422a;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.course-row {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fbff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sync-note {
  color: #1f58a7;
  font-size: 21rpx;
  font-weight: 800;
  text-align: right;
}

.course-title {
  display: block;
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
}

.course-media {
  display: block;
  margin-top: 10rpx;
  color: #526174;
  font-size: 23rpx;
  font-weight: 800;
}

.course-media.ready {
  color: #1f7a55;
}

.course-media.missing {
  color: #9a4b0b;
}

.course-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.row-button {
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  margin: 0;
  padding: 10rpx 14rpx;
  border: 1rpx solid #cfe0f4;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1f58a7;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  box-sizing: border-box;
}

.row-button.danger {
  border-color: #f0d2cc;
  background: #fff7f5;
  color: #9a3e2b;
}

.row-button::after {
  border: 0;
}

.empty-note {
  display: block;
  padding: 38rpx 0 16rpx;
  color: #526174;
  text-align: center;
  font-size: 24rpx;
}
