<view class="screen-page stats-page">
  <view class="hero">
    <text class="title">小程序使用情况</text>
    <text class="summary">老师和负责人可查看预约、课程、资料上传与功能使用情况。{{privacyNote}}</text>
    <text wx:if="{{generatedAt}}" class="time">更新时间：{{generatedAt}}</text>
    <button class="primary-button" bindtap="exportData">导出完整数据</button>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载统计...</view>

  <view wx:else>
    <view class="summary-grid">
      <view wx:for="{{summaryItems}}" wx:key="key" class="summary-card">
        <text class="summary-value">{{item.value}}</text>
        <text class="summary-label">{{item.label}}</text>
      </view>
    </view>

    <view class="panel">
      <text class="section-title">功能使用排行</text>
      <view wx:for="{{actionItems}}" wx:key="action" class="rank-row">
        <text class="rank-name">{{item.label}}</text>
        <text class="rank-count">{{item.count}}</text>
      </view>
      <view wx:if="{{!actionItems.length}}" class="empty inner">暂无使用记录。</view>
    </view>

    <view class="panel">
      <text class="section-title">最近预约</text>
      <view wx:for="{{recentBookings}}" wx:key="id" class="record-row">
        <text class="record-title">{{item.studentName}} · {{item.advisorName}}</text>
        <text class="record-meta">{{item.dateDisplay || item.date}} {{item.time}} · {{item.status}}</text>
      </view>
      <view wx:if="{{!recentBookings.length}}" class="empty inner">暂无预约记录。</view>
    </view>

    <view class="panel">
      <text class="section-title">最近使用行为</text>
      <view wx:for="{{recentUsage}}" wx:key="id" class="record-row">
        <text class="record-title">{{item.label}}</text>
        <text class="record-meta">{{item.createdAt}} · {{item.user.storageKey || '未知用户'}}</text>
      </view>
      <view wx:if="{{!recentUsage.length}}" class="empty inner">暂无使用行为。</view>
    </view>
  </view>
</view>
