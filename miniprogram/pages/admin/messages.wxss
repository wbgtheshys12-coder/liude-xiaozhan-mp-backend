.admin-messages-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #f7f9fc; color: #17243a; }
.hero { padding: 32rpx; border: 1rpx solid #dbe8f7; border-radius: 18rpx; background: #eef6ff; color: #17243a; box-shadow: none; }
.title, .summary, .student-name, .student-meta, .student-key, .sender, .content, .time, .last-time { display: block; }
.title { color: #17243a; font-size: 38rpx; font-weight: 900; }
.summary { margin-top: 12rpx; color: #34445a; font-size: 24rpx; line-height: 1.65; opacity: 1; }
.conversation-list { margin-top: 24rpx; }
.conversation-card { margin-bottom: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(31, 55, 88, .07); overflow: hidden; }
.conversation-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.student-copy { min-width: 0; flex: 1; }
.student-name { font-size: 30rpx; font-weight: 700; overflow-wrap: anywhere; }
.student-meta, .last-time { margin-top: 7rpx; color: #526174; font-size: 21rpx; overflow-wrap: anywhere; }
.student-key { margin-top: 7rpx; color: #526174; font-size: 19rpx; overflow-wrap: anywhere; }
.last-time { max-width: 240rpx; text-align: right; }
.message-list { height: 500rpx; margin-top: 20rpx; padding: 14rpx 18rpx; box-sizing: border-box; border: 1rpx solid #e5edf7; border-radius: 18rpx; background: #f7faff; }
.message { width: 84%; box-sizing: border-box; margin: 14rpx 0; padding: 16rpx 18rpx; border: 1rpx solid #e5edf7; border-radius: 16rpx; background: #ffffff; overflow-wrap: anywhere; }
.message.user { margin-left: auto; border-color: #d6e7fb; border-bottom-right-radius: 5rpx; background: #eaf3ff; }
.message.staff { margin-right: auto; border-bottom-left-radius: 5rpx; }
.sender { color: #1f58a7; font-size: 21rpx; font-weight: 800; }
.content { margin-top: 7rpx; color: #172235; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; }
.time { margin-top: 7rpx; color: #526174; font-size: 20rpx; }
.reply-input { width: 100%; min-height: 120rpx; max-height: 320rpx; box-sizing: border-box; margin-top: 18rpx; padding: 18rpx; border: 2rpx solid #cbd7e6; border-radius: 16rpx; background: #fafcff; color: #172235; font-size: 25rpx; overflow-wrap: anywhere; }
.reply-button { margin: 16rpx 0 0 auto; min-width: 210rpx; border-radius: 999rpx; background: #1f58a7; color: #fff; font-size: 25rpx; font-weight: 700; }
.reply-button[disabled] { border: 1rpx solid #cbd5e1; background: #e7ebf0; color: #34445a; opacity: 1; }
.empty { padding: 80rpx 20rpx; text-align: center; color: #526174; font-size: 25rpx; }
@media (max-width: 360px) { .admin-messages-page { padding: 20rpx; } .conversation-head { flex-direction: column; } .last-time { max-width: 100%; text-align: left; } .reply-button { width: 100%; } }
