.admin-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 52rpx;
  background: #f7f9fc;
  color: #17243a;
  box-sizing: border-box;
}

.admin-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-title {
  font-size: 36rpx;
  font-weight: 900;
}

.refresh-button,
.copy-button {
  min-width: 132rpx;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.refresh-button::after,
.copy-button::after {
  border: 0;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.summary-card,
.occupied-card,
.notice-card,
.booking-card {
  border: 1rpx solid #e3edf8;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.summary-card {
  padding: 24rpx;
}

.summary-value {
  display: block;
  color: #1f58a7;
  font-size: 42rpx;
  font-weight: 900;
}

.summary-label {
  display: block;
  margin-top: 6rpx;
  color: #526174;
  font-size: 24rpx;
  font-weight: 800;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 14rpx 26rpx;
  border: 1rpx solid #d6e5f6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #526174;
  font-size: 25rpx;
  font-weight: 900;
}

.filter-chip.active {
  border-color: #1f58a7;
  background: #eaf3ff;
  color: #1f58a7;
}

.occupied-card,
.notice-card,
.booking-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-title {
  display: block;
  color: #17243a;
  font-size: 27rpx;
  font-weight: 900;
}

.occupied-text,
.notice-card text {
  display: block;
  margin-top: 10rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.notice-card.warning {
  background: #fff7eb;
  border-color: #f3d6a8;
}

.booking-top,
.booking-footer,
.booking-line {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.booking-top {
  justify-content: space-between;
}

.booking-main {
  flex: 1;
  min-width: 0;
}

.student-name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-time {
  display: block;
  margin-top: 8rpx;
  color: #526174;
  font-size: 24rpx;
  font-weight: 800;
}

.status-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf7f3;
  color: #0d6658;
  font-size: 22rpx;
  font-weight: 900;
}

.booking-line {
  margin-top: 18rpx;
}

.line-label {
  flex: 0 0 72rpx;
  color: #526174;
  font-size: 24rpx;
  font-weight: 900;
}

.line-value {
  flex: 1;
  min-width: 0;
  color: #26364b;
  font-size: 25rpx;
  line-height: 1.45;
  word-break: break-all;
}

.booking-footer {
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2f7;
}

.subscription-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.subscription-title {
  color: #173f78;
  font-size: 27rpx;
  font-weight: 900;
}

.subscription-desc {
  color: #526174;
  font-size: 24rpx;
  line-height: 1.55;
}

.subscribe-button {
  width: 100%;
  min-height: 76rpx;
  margin: 4rpx 0 0;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.created-text {
  flex: 1;
  min-width: 0;
  color: #526174;
  font-size: 22rpx;
}

.copy-button {
  min-width: 144rpx;
  background: #ffffff;
  color: #1f58a7;
  border: 1rpx solid #bcd2ee;
}
