.plan-page {
  min-height: 100vh;
  padding: 30rpx;
  background: #f7f9fc;
}

.hero {
  padding: 34rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dbe8f7;
  background: #eef6ff;
  color: #17243a;
  box-shadow: none;
}

.eyebrow,
.title,
.summary,
.stage-time,
.stage-title,
.stage-desc {
  display: block;
}

.eyebrow {
  font-size: 23rpx;
  font-weight: 900;
  color: #1f58a7;
}

.title {
  margin-top: 12rpx;
  color: #17243a;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.summary {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.58;
  color: #34445a;
}

.timeline {
  margin-top: 24rpx;
}

.stage-card {
  display: flex;
  gap: 18rpx;
}

.stage-line {
  width: 34rpx;
  display: flex;
  justify-content: center;
}

.stage-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 32rpx;
  border-radius: 50%;
  background: #1f58a7;
  box-shadow: none;
}

.stage-copy {
  flex: 1;
  min-width: 0;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5edf7;
  box-shadow: none;
}

.stage-time {
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.stage-title {
  margin-top: 8rpx;
  color: #17243a;
  font-size: 30rpx;
  font-weight: 900;
}

.stage-desc {
  margin-top: 12rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.58;
}

.task-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.task-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 12rpx;
}

.primary-button,
.secondary-button {
  min-height: 78rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.primary-button {
  background: #1f58a7;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  color: #1f58a7;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
