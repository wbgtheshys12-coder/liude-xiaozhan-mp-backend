.school-page {
  min-height: 100vh;
  padding: 28rpx 30rpx 52rpx;
  background: #f7f9fc;
}

.hero-card {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dbe8f7;
  background: #eef6ff;
  color: #17243a;
  box-shadow: none;
}

.hero-logo {
  flex-shrink: 0;
  width: 142rpx;
  height: 142rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.rank {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.school-name {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.english-name,
.german-name {
  display: block;
  margin-top: 8rpx;
  color: #34445a;
  font-size: 23rpx;
  line-height: 1.35;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.info-item,
.section-card {
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5edf7;
  box-shadow: none;
}

.info-item {
  padding: 20rpx;
}

.info-item.wide {
  grid-column: 1 / -1;
}

.info-label {
  display: block;
  color: #526174;
  font-size: 22rpx;
  line-height: 1.3;
}

.info-value {
  display: block;
  margin-top: 8rpx;
  color: #17243a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.4;
}

.section-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.section-title {
  display: block;
  color: #17243a;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.paragraph {
  display: block;
  margin-top: 14rpx;
  color: #47566d;
  font-size: 25rpx;
  line-height: 1.65;
}

.bullet-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.bullet-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #1f58a7;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  color: #47566d;
  font-size: 25rpx;
  line-height: 1.55;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.program-tag,
.fit-tag {
  max-width: 100%;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.program-tag {
  background: #eaf3ff;
  color: #1f58a7;
}

.fit-tag {
  background: #eaf3ff;
  color: #1f58a7;
}

.website-card {
  padding-bottom: 22rpx;
}

.website-url {
  display: block;
  margin-top: 14rpx;
  color: #1f58a7;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.ghost-button,
.primary-button,
.secondary-button {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.ghost-button {
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid rgba(31, 88, 167, 0.22);
  background: #f5f9ff;
  color: #1f58a7;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tuition-card {
  border-color: #cfe0f5;
  background: #f7fbff;
}

.tuition-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tuition-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 20rpx;
  font-weight: 900;
}

.tuition-label {
  display: block;
  margin-top: 16rpx;
  color: #1f4f87;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.source-note {
  display: block;
  margin-top: 14rpx;
  color: #65748a;
  font-size: 21rpx;
  line-height: 1.55;
}

.action-row .primary-button,
.action-row .secondary-button {
  flex: 1 1 300rpx;
  min-width: 0;
}

.primary-button {
  background: #1f58a7;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid rgba(31, 88, 167, 0.18);
  background: #ffffff;
  color: #1f58a7;
}

.ghost-button::after,
.primary-button::after,
.secondary-button::after {
  border: 0;
}

.button-hover {
  opacity: 0.82;
}
.program-detail { padding:24rpx 0;border-bottom:1rpx solid #dbe6f2;overflow-wrap:anywhere; }
.program-heading { display:block;font-weight:700;color:#17243a;font-size:29rpx; }
