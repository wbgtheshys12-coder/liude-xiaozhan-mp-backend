.booking-page {
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #f7f9fc;
}

.booking-head {
  padding: 42rpx 30rpx 22rpx;
  background: #ffffff;
}

.booking-title {
  display: block;
  color: #17243a;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.booking-service {
  display: flex;
  align-items: center;
  gap: 20rpx;
  max-width: 100%;
  overflow: hidden;
  margin-top: 34rpx;
}

.booking-copy {
  flex: 1;
  min-width: 0;
}

.booking-progress-wrap {
  padding: 0 30rpx 18rpx;
}

.booking-progress-wrap .loading-card {
  margin-top: 16rpx;
}

.booking-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #eef6ff;
}

.service-name {
  display: block;
  color: #17243a;
  font-size: 31rpx;
  font-weight: 900;
}

.service-price {
  display: block;
  margin-top: 12rpx;
  color: #1f58a7;
  font-size: 28rpx;
  font-weight: 900;
}

.service-note {
  display: block;
  margin-top: 10rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.45;
}

.booking-section {
  margin-top: 16rpx;
  padding: 26rpx 30rpx;
  border-top: 1rpx solid #eef1f5;
  border-bottom: 1rpx solid #eef1f5;
  background: #ffffff;
}

.student-name-section {
  padding-top: 28rpx;
}

.bound-profile-section { padding-top: 28rpx; }
.bound-profile-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.bound-profile-tip { display: block; margin-top: 8rpx; color: #526174; font-size: 22rpx; line-height: 1.5; }
.bound-status { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 999rpx; background: #eaf3ff; color: #1f58a7; font-size: 21rpx; font-weight: 900; }
.bound-profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; }
.bound-profile-item { min-width: 0; padding: 16rpx 18rpx; box-sizing: border-box; border: 1rpx solid #dbe6f2; border-radius: 15rpx; background: #f8fbff; }
.bound-profile-item.full { grid-column: 1 / -1; }
.bound-label, .bound-value, .bound-profile-note { display: block; }
.bound-label { color: #657188; font-size: 20rpx; }
.bound-value { margin-top: 6rpx; color: #17243a; font-size: 25rpx; font-weight: 800; overflow-wrap: anywhere; }
.bound-profile-note { margin-top: 16rpx; color: #526174; font-size: 21rpx; line-height: 1.55; }

.student-name-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.required-tag {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 21rpx;
  font-weight: 900;
}

.student-name-input {
  width: 100%;
  min-height: 78rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.student-name-tip {
  display: block;
  margin-top: 12rpx;
  color: #526174;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.booking-profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.booking-profile-field,
.application-level-field {
  min-width: 0;
}

.application-level-field {
  margin-top: 24rpx;
}

.profile-label {
  min-width: 0;
  color: #17243a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.required-star {
  flex-shrink: 0;
  color: #d93025;
  font-size: 28rpx;
  font-weight: 900;
}

.student-name-input.compact {
  margin-top: 12rpx;
  padding: 0 16rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.level-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 14rpx;
}

.level-option {
  min-width: 0;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #526174;
  font-size: 25rpx;
  font-weight: 900;
  text-align: center;
}

.level-option.active {
  border-color: #1f58a7;
  background: #eaf3ff;
  color: #1f58a7;
}

.date-row,
.advisor-row {
  white-space: nowrap;
}

.date-picker-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
}

.date-picker-copy {
  flex: 1;
  min-width: 0;
}

.picker-label,
.picker-date,
.picker-range {
  display: block;
}

.picker-label {
  color: #526174;
  font-size: 22rpx;
  font-weight: 900;
}

.picker-date {
  margin-top: 8rpx;
  color: #17243a;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.picker-range {
  margin-top: 6rpx;
  color: #526174;
  font-size: 22rpx;
  line-height: 1.35;
}

.picker-button {
  flex-shrink: 0;
  min-height: 60rpx;
  min-width: 150rpx;
  max-width: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.date-row {
  margin-top: 22rpx;
}

.date-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 86rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: #f5f7fb;
  color: #526174;
  font-weight: 900;
}

.date-card.active {
  background: #1f58a7;
  color: #ffffff;
}

.date-week,
.date-num {
  display: block;
  font-size: 23rpx;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 26rpx;
}

.time-card {
  min-height: 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  color: #17243a;
  font-size: 27rpx;
}

.time-card.active {
  border-color: #1f58a7;
  background: #eaf3ff;
  color: #1f58a7;
  font-weight: 900;
}

.time-card.disabled {
  border-color: #e3e7ef;
  background: #f0f3f8;
  color: #5d6878;
}

.time-card.past {
  border-color: #dde2ea;
  background: #edf1f6;
  color: #59677a;
  opacity: 1;
}

.time-card.booked {
  border-color: #e6d6d1;
  background: #f8eee9;
  color: #864431;
}

.time-card.disabled.active {
  border-color: #e3e7ef;
  background: #f0f3f8;
  color: #5d6878;
}

.time-state {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.1;
}

.slot-note {
  display: block;
  margin-top: 14rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.4;
}

.slot-note.warning {
  color: #9c3b23;
  font-weight: 800;
}

.advisor-availability-note {
  display: block;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #cfe1f7;
  border-radius: 12rpx;
  background: #eef6ff;
  color: #1f4f87;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.5;
}

.section-title {
  display: block;
  color: #17243a;
  font-size: 30rpx;
  font-weight: 900;
}

.advisor-row {
  margin-top: 22rpx;
}

.advisor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.advisor-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 150rpx;
  padding: 24rpx 18rpx;
  border: 1rpx solid #e2e7ef;
  border-radius: 14rpx;
  background: #ffffff;
}

.advisor-card.active {
  border-color: #1f58a7;
  background: #eaf3ff;
}

.advisor-name {
  display: block;
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
}

.advisor-desc {
  display: block;
  width: 100%;
  margin-top: 8rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.42;
  text-align: center;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.notify-card {
  border-left: 8rpx solid #1f58a7;
}

.wechat-contact-card {
  border: 1rpx solid #cfe1f7;
  background: #eef6ff;
}

.wechat-contact-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.wechat-contact-copy {
  flex: 1;
  min-width: 0;
}

.wechat-contact-id,
.wechat-contact-desc {
  display: block;
  overflow-wrap: anywhere;
}

.wechat-contact-id {
  margin-top: 10rpx;
  color: #1f58a7;
  font-size: 27rpx;
  font-weight: 900;
}

.wechat-contact-desc {
  margin-top: 16rpx;
  color: #34445a;
  font-size: 24rpx;
  line-height: 1.58;
}

.copy-wechat-button {
  flex-shrink: 0;
  width: 190rpx;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 66rpx;
  text-align: center;
  white-space: normal;
}

.copy-wechat-button::after {
  border: 0;
}

.notify-title,
.notify-desc {
  display: block;
}

.notify-title {
  margin-top: 8rpx;
  color: #1f58a7;
  font-size: 27rpx;
  font-weight: 900;
}

.notify-desc {
  margin-top: 10rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.58;
}

.note-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.note-count {
  color: #526174;
  font-size: 24rpx;
}

.note-area {
  width: 100%;
  min-height: 150rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 10rpx;
  background: #f5f7fb;
  color: #17243a;
  font-size: 26rpx;
  line-height: 1.5;
}

.booking-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5edf7;
  box-shadow: none;
}

.booking-footer > view {
  flex: 1;
  min-width: 0;
}

.footer-label {
  display: block;
  color: #526174;
  font-size: 22rpx;
}

.footer-value {
  display: block;
  margin-top: 6rpx;
  color: #1f58a7;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.footer-advisor {
  display: block;
  margin-top: 4rpx;
  color: #526174;
  font-size: 22rpx;
  font-weight: 800;
}

.submit-button {
  flex-shrink: 0;
  width: 236rpx;
  min-width: 0;
  max-width: 40%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.submit-button::after {
  border: 0;
}

.submit-button[disabled] {
  border: 1rpx solid #cbd5e1;
  background: #e7ebf0;
  color: #34445a;
  opacity: 1;
}
.booking-section .input { width:100%;box-sizing:border-box;min-height:84rpx;margin:16rpx 0 30rpx;padding:20rpx;background:#f1f5fb;border-radius:14rpx;font-size:28rpx;color:#17243a; }
.booking-section textarea { margin:20rpx 0;padding:20rpx;background:#f1f5fb;border-radius:14rpx;font-size:28rpx; }
.booking-section .primary-button { margin:24rpx 0;background:#1f58a7;color:#fff; }
