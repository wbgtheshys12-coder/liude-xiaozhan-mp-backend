.service-page {
  min-height: 100vh;
  background: #f7f9fc;
}

.service-top {
  padding: 44rpx 30rpx 34rpx;
  background: #eef6ff;
  color: #17243a;
}

.page-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.date-row {
  display: flex;
  gap: 14rpx;
  margin-top: 36rpx;
  overflow-x: auto;
}

.date-pill {
  flex: 0 0 auto;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe8f7;
  background: #ffffff;
  color: #1f58a7;
  font-size: 25rpx;
  font-weight: 900;
}

.date-pill.active {
  background: #1f58a7;
  color: #ffffff;
}

.service-list {
  margin-top: 0;
  padding: 24rpx 30rpx 48rpx;
  border-radius: 0;
  background: #ffffff;
}

.service-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.service-image {
  flex-shrink: 0;
  width: 136rpx;
  height: 136rpx;
  border-radius: 14rpx;
  background: #f1f6ff;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-title {
  display: block;
  color: #17243a;
  font-size: 30rpx;
  font-weight: 900;
}

.service-desc {
  display: block;
  margin-top: 8rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.45;
}

.service-price {
  display: block;
  margin-top: 12rpx;
  color: #1f58a7;
  font-size: 28rpx;
  font-weight: 900;
}

.service-booked {
  display: block;
  margin-top: 4rpx;
  color: #526174;
  font-size: 22rpx;
}

.service-page .service-button {
  flex-shrink: 0;
  width: 120rpx;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.service-button::after {
  border: 0;
}
.service-list .service-item { flex-direction: column; align-items: stretch; gap: 18rpx; }
.service-list .service-image { width: 100%; height: 100rpx; }
.service-list .service-copy { width: auto; min-width: 0; }
.service-list .service-button { width: 100%; margin: 0; flex-shrink: 0; }
