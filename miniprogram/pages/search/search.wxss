.search-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f7f9fc;
}

.search-head {
  padding: 28rpx 30rpx 26rpx;
  border: 1rpx solid #dbe8f7;
  background: #eef6ff;
}

.search-box {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 16rpx 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-icon {
  color: #1f58a7;
  font-size: 34rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: #17243a;
  font-size: 26rpx;
}

.search-button {
  flex-shrink: 0;
  min-width: 104rpx;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.search-button::after {
  border: 0;
}

.hot-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  overflow-x: auto;
}

.hot-tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe8f7;
  background: #ffffff;
  color: #1f58a7;
  font-size: 23rpx;
  font-weight: 900;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  padding: 22rpx 30rpx 6rpx;
  overflow-x: auto;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #627086;
  font-size: 24rpx;
  font-weight: 900;
  border: 1rpx solid #e5edf7;
  box-shadow: none;
}

.filter-chip.active {
  background: #1f58a7;
  color: #ffffff;
}

.result-list {
  padding: 12rpx 30rpx 0;
}

.result-card,
.empty-card {
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5edf7;
  box-shadow: none;
}

.result-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 22rpx;
}

.result-logo,
.result-icon {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
}

.result-logo {
  background: #f3f7ff;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 24rpx;
  font-weight: 900;
}

.result-copy {
  flex: 1;
  min-width: 0;
}

.result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-title {
  flex: 1;
  min-width: 0;
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-badge {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.result-subtitle,
.result-desc {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-subtitle {
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
}

.result-desc {
  color: #526174;
  font-size: 22rpx;
}

.result-arrow {
  flex-shrink: 0;
  color: #526174;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-card {
  margin-top: 22rpx;
  padding: 34rpx;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #17243a;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.55;
}
