.button-row button {
  flex: 1 1 260rpx;
}

.ai-notice {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  background: #f7f9fc;
  color: #526174;
  font-size: 22rpx;
  line-height: 1.55;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(31, 88, 167, 0.06);
}

.reason-item {
  color: #516173;
  font-size: 24rpx;
  line-height: 1.5;
}
