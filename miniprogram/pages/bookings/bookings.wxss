.bookings-page {
  min-height: 100vh;
  padding: 36rpx 30rpx 140rpx;
  background: #f7f9fc;
  box-sizing: border-box;
}

.bookings-head {
  padding: 28rpx;
  border-radius: 16rpx;
  background: #1f58a7;
  color: #ffffff;
}

.bookings-title,
.bookings-subtitle,
.empty-title,
.empty-desc,
.booking-time,
.booking-advisor,
.label,
.value,
.local-note {
  display: block;
}

.bookings-title {
  font-size: 34rpx;
  font-weight: 900;
}

.bookings-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  opacity: 0.92;
}

.loading-card,
.empty-card,
.booking-card,
.message {
  margin-top: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5edf7;
  background: #ffffff;
}

.loading-card {
  padding: 24rpx;
}

.loading-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loading-title,
.loading-percent {
  color: #17243a;
  font-size: 25rpx;
  font-weight: 900;
}

.loading-track {
  height: 12rpx;
  overflow: hidden;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #e7edf6;
}

.loading-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #1f58a7;
}

.loading-desc {
  display: block;
  margin-top: 12rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.4;
}

.message {
  padding: 20rpx 22rpx;
  color: #526174;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.message.error {
  color: #9c3b23;
  background: #fff4ef;
  border-color: #f0d2c6;
}

.empty-card {
  padding: 36rpx 28rpx;
  text-align: center;
}

.empty-title {
  color: #17243a;
  font-size: 31rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.45;
}

.booking-card {
  padding: 26rpx;
}

.booking-card.cancelled {
  border-color: #d9e0e9;
  background: #fafbfc;
  opacity: 1;
}

.booking-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.booking-main {
  flex: 1;
  min-width: 0;
}

.booking-time {
  color: #17243a;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.booking-advisor {
  margin-top: 8rpx;
  color: #1f58a7;
  font-size: 24rpx;
  font-weight: 900;
}

.status-pill {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.status-pill.cancelled {
  background: #f1f3f6;
  color: #566273;
}

.booking-line {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.label {
  color: #526174;
  font-size: 23rpx;
  font-weight: 900;
}

.value {
  color: #17243a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.local-note {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #fff8e5;
  color: #8a6400;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.booking-actions,
.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5edf7;
  background: #ffffff;
}

.primary-button,
.secondary-button,
.copy-button,
.cancel-button,
.disabled-button {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.primary-button,
.copy-button {
  background: #1f58a7;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #dbe8f7;
  background: #ffffff;
  color: #1f58a7;
}

.cancel-button {
  background: #fff4ef;
  color: #c2412d;
}

.disabled-button {
  background: #f1f3f6;
  color: #5d6878;
  opacity: 1;
}

.primary-button::after,
.secondary-button::after,
.copy-button::after,
.cancel-button::after,
.disabled-button::after {
  border: 0;
}
