.me-page {
  min-height: 100vh;
  padding: 44rpx 30rpx 50rpx;
  background: #f7f9fc;
}

.me-title {
  color: #17243a;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.me-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #526174;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.member-card {
  margin-top: 30rpx;
  overflow: hidden;
  border: 1rpx solid #dbe8f7;
  border-radius: 20rpx;
  background: #eef6ff;
  color: #17243a;
}

.member-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 28rpx 18rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #1f58a7;
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
}

.avatar-image {
  width: 88rpx;
  height: 88rpx;
  display: block;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-badge {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.profile-bind-button {
  flex-shrink: 0;
  width: 164rpx;
  min-width: 0;
  max-width: 34%;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: normal;
  text-align: center;
}

.profile-bind-button::after {
  border: 0;
}

.member-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 28rpx 26rpx;
}

.member-tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #1f58a7;
  font-size: 22rpx;
  font-weight: 900;
}

.member-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  color: #34445a;
  font-size: 25rpx;
  font-weight: 900;
}

.member-footer text {
  flex: 1;
  min-width: 0;
  line-height: 1.35;
}

.detail-button {
  flex-shrink: 0;
  width: 138rpx;
  min-width: 0;
  max-width: 34%;
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: normal;
  text-align: center;
}

.detail-button::after {
  border: 0;
}

.student-profile-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5edf7;
  background: #ffffff;
}

.profile-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-card-title,
.profile-card-subtitle,
.profile-field-label,
.profile-field-value {
  display: block;
}

.profile-card-title {
  color: #17243a;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-card-subtitle {
  margin-top: 6rpx;
  color: #526174;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-edit-button {
  flex-shrink: 0;
  min-width: 118rpx;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #1f58a7;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.profile-edit-button::after {
  border: 0;
}

.profile-action-button {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d6e4f4;
  background: #eef6ff;
  color: #1f58a7;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.profile-action-button::after {
  border: 0;
}

.profile-field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.profile-field-row {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.profile-field-row.important {
  margin-top: 22rpx;
  background: #eef6ff;
}

.profile-field-label {
  color: #526174;
  font-size: 22rpx;
  font-weight: 900;
}

.profile-field-value {
  margin-top: 8rpx;
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.profile-field-value.empty {
  color: #526174;
}

.official-follow-card {
  margin-top: 20rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  background: #eef6ff;
}

.official-follow-title,
.official-follow-desc,
.official-follow-note {
  display: block;
}

.official-follow-title {
  color: #17243a;
  font-size: 28rpx;
  font-weight: 900;
}

.official-follow-desc {
  margin-top: 8rpx;
  color: #34445a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
}

.official-account-box {
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ffffff;
}

.official-follow-note {
  margin-top: 12rpx;
  color: #65748a;
  font-size: 21rpx;
  line-height: 1.45;
}

.stats-card,
.menu-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5edf7;
  background: #ffffff;
}

.stats-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.stat-item {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.stat-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf3ff;
  color: #1f58a7;
  font-size: 30rpx;
  font-weight: 900;
}

.stat-icon-image {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.stat-title,
.stat-value {
  display: block;
}

.stat-title {
  color: #526174;
  font-size: 23rpx;
  overflow-wrap: anywhere;
}

.stat-value {
  margin-top: 2rpx;
  color: #17243a;
  font-size: 30rpx;
}

.menu-section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.section-title,
.section-desc {
  display: block;
}

.section-title {
  color: #17243a;
  font-size: 29rpx;
  font-weight: 900;
}

.section-desc {
  margin-top: 6rpx;
  color: #67768a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.menu-section .menu-card {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  min-height: 96rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  box-sizing: border-box;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eaf3ff;
}

.menu-icon-image {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.menu-title {
  flex: 1;
  min-width: 0;
  color: #17243a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(21, 34, 56, 0.48);
}

.bind-dialog {
  width: 100%;
  height: 90%;
  max-height: 1000rpx;
  max-width: 620px;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #17243a;
}

.dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.dialog-title {
  color: #17243a;
  font-size: 32rpx;
  font-weight: 900;
}

.dialog-close {
  width: 56rpx;
  min-width: 44px;
  min-height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #526174;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.dialog-desc {
  display: block;
  margin-top: 14rpx;
  color: #526174;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.bind-preview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 16rpx;
  background: #eef6ff;
}

.bind-avatar {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #ffffff;
  color: #1f58a7;
  font-size: 36rpx;
  font-weight: 900;
}

.bind-avatar-image {
  width: 92rpx;
  height: 92rpx;
  display: block;
}

.bind-preview-copy {
  flex: 1;
  min-width: 0;
}

.bind-preview-name,
.bind-preview-note {
  display: block;
}

.bind-preview-name {
  color: #17243a;
  font-size: 29rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bind-preview-note {
  margin-top: 8rpx;
  color: #526174;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.dialog-avatar-button,
.dialog-nickname-input {
  width: 100%;
  min-height: 76rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.dialog-avatar-button {
  margin-left: 0;
  margin-right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  background: #eaf3ff;
  color: #1f58a7;
  line-height: 1.2;
  white-space: normal;
  text-align: center;
}

.dialog-avatar-button::after {
  border: 0;
}

.dialog-nickname-input {
  padding: 0 22rpx;
  border: 1rpx solid #dbe8f7;
  background: #f7f9fc;
  color: #17243a;
  line-height: 76rpx;
}

.profile-form {
  margin-top: 22rpx;
}

.profile-input-row {
  display: block;
  margin-top: 16rpx;
}

.profile-input-label {
  display: block;
  margin-bottom: 8rpx;
  color: #526174;
  font-size: 23rpx;
  font-weight: 900;
}

.profile-input {
  width: 100%;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #dbe8f7;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #17243a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.student-level-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.student-level-option { min-width: 0; min-height: 72rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #dbe8f7; border-radius: 12rpx; background: #f7f9fc; color: #526174; font-size: 24rpx; font-weight: 900; }
.student-level-option.active { border-color: #1f58a7; background: #eaf3ff; color: #1f58a7; }

.dialog-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.dialog-cancel,
.dialog-confirm {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: normal;
  text-align: center;
}

.dialog-cancel {
  border: 1rpx solid #dbe8f7;
  background: #ffffff;
  color: #526174;
}

.dialog-confirm {
  background: #1f58a7;
  color: #ffffff;
}

.dialog-cancel::after,
.dialog-confirm::after {
  border: 0;
}
