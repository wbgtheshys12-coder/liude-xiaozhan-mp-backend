.onboarding-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 48rpx; background: #f4f7fb; color: #17243a; }
.intro-card, .form-card, .privacy-card { box-sizing: border-box; border: 1rpx solid #dbe8f7; border-radius: 24rpx; background: #fff; }
.intro-card { padding: 30rpx; background: #eef6ff; }
.intro-tag, .intro-title, .intro-desc, .privacy-title, .privacy-desc { display: block; }
.intro-tag { color: #1f58a7; font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }
.intro-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 900; }
.intro-desc { margin-top: 12rpx; color: #34445a; font-size: 25rpx; line-height: 1.65; }
.legacy-note { margin-top: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #bcd5f2; border-radius: 18rpx; background: #edf6ff; color: #24496f; font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.form-card { margin-top: 22rpx; padding: 8rpx 24rpx 24rpx; }
.contact-note { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #eef6ff; color: #355a82; font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }
.field { display: block; margin-top: 22rpx; }
.field-head { display: flex; align-items: center; gap: 6rpx; color: #17243a; font-size: 25rpx; font-weight: 800; }
.required { color: #c93434; }
.field-input { width: 100%; min-height: 82rpx; margin-top: 12rpx; padding: 0 20rpx; box-sizing: border-box; border: 2rpx solid #d4e0ee; border-radius: 16rpx; background: #f8fbff; color: #17243a; font-size: 26rpx; line-height: 82rpx; }
.field-input[disabled] { background: #eef2f6; color: #526174; }
.level-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 12rpx; }
.level-option { min-width: 0; min-height: 78rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #d4e0ee; border-radius: 16rpx; background: #f8fbff; color: #34445a; font-size: 25rpx; font-weight: 800; }
.level-option.active { border-color: #1f58a7; background: #eaf3ff; color: #1f58a7; }
.level-option.disabled { opacity: .72; }
.privacy-card { margin-top: 20rpx; padding: 22rpx 24rpx; }
.privacy-title { color: #1f58a7; font-size: 24rpx; font-weight: 900; }
.privacy-desc { margin-top: 8rpx; color: #526174; font-size: 22rpx; line-height: 1.6; }
.submit-button { width: 100%; min-height: 88rpx; margin-top: 24rpx; border-radius: 999rpx; background: #1f58a7; color: #fff; font-size: 28rpx; font-weight: 900; line-height: 88rpx; }
.submit-button::after { border: 0; }
.submit-button[disabled] { background: #dce4ee; color: #526174; opacity: 1; }
.field-hint { margin-left: auto; color: #526174; font-size: 22rpx; font-weight: 400; }
.contact-field { margin-top: 8rpx; }
.level-option { margin: 0; padding: 12rpx; line-height: 1.5; }
.level-option::after, .retry-button::after { border: 0; }
.confirm-note { display: block; margin-top: 14rpx; color: #34445a; font-size: 23rpx; line-height: 1.65; font-weight: 700; }
.retry-button { margin-top: 16rpx; background: #fff; color: #1f58a7; border: 1rpx solid #bdd2eb; font-size: 24rpx; }
