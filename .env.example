PORT=3108
WECHAT_APPID=change_to_miniprogram_appid
WECHAT_SECRET=change_to_miniprogram_appsecret
OCR_ALLOW_REMOTE_TESSDATA=false
OCR_TESSDATA_DIR=./tessdata
MP_ALLOWED_OPENIDS=openid_1,openid_2
MP_ALLOW_DEV_LOGIN=false
MP_OPEN_LOGIN=true
MP_LOG_DENIED_OPENID=false
MP_USER_ENTITLEMENTS_JSON={}
MP_FREE_RECOMMENDATION_COUNTS=1,3,6
MP_BOOKING_NOTIFY_ENABLED=false
MP_BOOKING_TEMPLATE_ID=
MP_BOOKING_TEMPLATE_FIELDS_JSON={"time1":"dateTime","thing2":"留学咨询预约","thing3":"studentName","thing4":"advisorName","thing5":"note"}
MP_TEACHER_OPENIDS_JSON={"a1":["zhang_teacher_openid"],"a2":["lu_teacher_openid"]}
MP_OWNER_OPENIDS_JSON=["owner_openid"]
MP_ADMIN_OPENIDS_JSON=[]
# 仅存 Render Secret；用于 https://你的后端域名/admin 的电脑后台登录。
MP_ADMIN_WEB_TOKEN=generate_a_different_long_random_secret_in_render_only
MP_DOCUMENT_DOWNLOAD_FREE=true
MP_BOOKING_WEBHOOK_URL=
# 客服消息默认复用预约 Webhook；如需发送到单独的企业群，可另设：
MP_CUSTOMER_MESSAGE_WEBHOOK_URL=
MP_BOOKING_TEACHER_WEBHOOKS_JSON={}
MP_BOOKING_MINIPROGRAM_STATE=formal
MP_BOOKING_SUBSCRIPTION_MODE=one-time
MP_DATA_DIR=./data
# 腾讯云私有 COS 持久化。SecretId/SecretKey 只能保存到 Render Secret 环境变量。
MP_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=liude-xiaozhan-prod-1473723135
TENCENT_COS_REGION=ap-shanghai
# 通常留空；如同一存储桶需要隔离多套环境，可填写例如 production。
MP_COS_ROOT_PREFIX=
MP_COS_METADATA_SYNC_INTERVAL_MS=60000
# 分片上传默认允许单个 512MiB；正式长课优先使用云点播，不要继续提高 Render 本地盘上限。
MP_MAX_COURSE_VIDEO_BYTES=536870912
MP_COURSE_VIDEO_CHUNK_BYTES=4194304
MP_COURSE_VIDEO_UPLOAD_TTL_MS=21600000
MP_MEDIA_SIGNING_SECRET=generate_a_long_random_secret_in_render_only
MP_MEDIA_URL_TTL_SECONDS=3600
# 小程序登录令牌默认有效 30 天，并使用稳定密钥加密；未单独配置时复用 MP_MEDIA_SIGNING_SECRET。
MP_SESSION_SECRET=
MP_SESSION_TTL_SECONDS=2592000
# 收费上线前保持 false。基本存款账户信息不写入环境变量；以下仅能保存微信支付商户平台生成的机密配置。
MP_PAYMENT_ENABLED=false
# 小程序支付/JSAPI 权限和商户号与 AppID 绑定在平台确认完成后，再分别改为 true。
MP_PAYMENT_JSAPI_ENABLED=false
MP_PAYMENT_APPID_BOUND=false
WECHAT_PAY_MCHID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
# 私钥与微信支付公钥优先使用 Render Secret File 路径；不要提交到 GitHub。
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://liude-xiaozhan-mp-backend.onrender.com/api/mp/payment/notify
# 金额单位为分。正式定价确认前保持空对象；feature 目前支持 materialAssistant / recommendationCount。
MP_PAYMENT_PRODUCTS_JSON={}
# 订单必须写入持久化存储；可使用 Render Persistent Disk，或启用上面的私有 COS 元数据备份。
# MP_PAYMENT_ORDERS_FILE=/var/data/liude-xiaozhan/payment-orders.jsonl
# 通常只配置 MP_DATA_DIR；下面变量仅在确需拆分存储路径时启用。
# MP_BOOKINGS_FILE=/var/data/bookings.jsonl
# MP_USAGE_FILE=/var/data/usage.jsonl
# MP_MESSAGES_FILE=/var/data/messages.jsonl
# MP_COURSE_VIDEO_DIR=/var/data/course-videos
# MP_TRANSCRIPT_TEMPLATES_FILE=/var/data/transcript-templates.private.json
# 关联公众号原始 ID（gh_ 开头）；留空时小程序显示复制名称与海报指引。
MP_OFFICIAL_ACCOUNT_USERNAME=
